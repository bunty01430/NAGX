import { VerticalBox, HorizontalBox, Button, LineEdit, TextEdit } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "NAGX Connect";
    width: 1360px;
    height: 820px;
    min-width: 960px;
    min-height: 600px;
    background: #080b10;

    property <string> status-text: "DISCONNECTED";
    property <string> server-text: "No server connected";
    property <styled-text> terminal-styled: @markdown("NAGX terminal offline.");
    property <int> cursor-x: 0;
    property <int> cursor-y: 0;
    property <bool> cursor-visible: false;

    callback connect(string, string, string);
    callback terminal-key(string, bool, bool);
    function focus-terminal() { terminal-input.focus(); }

    VerticalBox {
        spacing: 0px;

        Rectangle {
            height: 54px;
            background: #0d1219;
            HorizontalBox {
                padding-left: 18px;
                padding-right: 18px;
                alignment: center;
                spacing: 16px;

                Text {
                    text: "NAGX";
                    color: #64ffda;
                    font-size: 24px;
                    font-weight: 700;
                }

                Text {
                    text: "CONNECT";
                    color: #718096;
                    font-size: 12px;
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: root.status-text;
                    color: #64ffda;
                    font-size: 12px;
                }
            }
        }

        HorizontalBox {
            spacing: 0px;

            Rectangle {
                width: 280px;
                background: #0a0e14;

                VerticalBox {
                    padding: 18px;
                    spacing: 12px;

                    Text {
                        text: "CONNECTION";
                        color: #718096;
                        font-size: 11px;
                    }

                    LineEdit {
                        id: host-input;
                        placeholder-text: "host or IP";
                    }

                    LineEdit {
                        id: user-input;
                        placeholder-text: "username";
                    }

                    LineEdit {
                        id: password-input;
                        placeholder-text: "password";
                        input-type: password;
                    }

                    Button {
                        text: "CONNECT";
                        clicked => { root.connect(host-input.text, user-input.text, password-input.text); }
                    }

                    Rectangle { vertical-stretch: 1; }

                    Text {
                        text: "SESSION";
                        color: #718096;
                        font-size: 11px;
                    }
                    Text {
                        text: root.server-text;
                        color: #d7dee8;
                        font-size: 13px;
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: #06090d;

                VerticalBox {
                    padding: 18px;
                    spacing: 12px;

                    HorizontalBox {
                        height: 26px;
                        spacing: 12px;

                        Text {
                            text: "NAGX TERMINAL";
                            color: #d7dee8;
                            font-size: 16px;
                            font-weight: 700;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        Text {
                            text: "VT100 / ANSI / 120×32";
                            color: #718096;
                            font-size: 11px;
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: #020407;
                        border-width: 1px;
                        border-color: #18212c;

                        StyledText {
                            x: 10px;
                            y: 8px;
                            width: parent.width - 20px;
                            height: parent.height - 16px;
                            text: root.terminal-styled;
                            font-family: "Cascadia Mono";
                            font-size: 14px;
                        }

                        terminal-input := TextEdit {
                            width: parent.width;
                            height: parent.height;
                            text: "";
                            read-only: false;
                            color: transparent;
                            selection-foreground-color: transparent;
                            selection-background-color: transparent;
                            background: transparent;
                            cursor-width: 0px;
                            key-pressed(event) => {
                                root.terminal-key(event.text, event.modifiers.control, event.modifiers.alt);
                                accept
                            }
                        }

                        Rectangle {
                            visible: root.cursor-visible;
                            x: 10px + root.cursor-x * 8.45px;
                            y: 8px + root.cursor-y * 17.0px;
                            width: 2px;
                            height: 16px;
                            background: #64ffda;
                        }
                    }
                }
            }
        }
    }
}
