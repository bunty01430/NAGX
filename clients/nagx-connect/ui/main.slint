import { VerticalBox, HorizontalBox, Button, LineEdit, TextEdit } from "std-widgets.slint";

export struct TerminalData {
    id: int,
    name: string,
    state: string,
    host: string,
    user: string,
    shell: string,
    content: styled-text,
    plain: string,
    cursor-x: int,
    cursor-y: int,
    cursor-visible: bool,
    mouse-reporting: bool,
    focused: bool,
}

export component TerminalWindow inherits Rectangle {
    in property <TerminalData> data;
    in property <int> index;

    callback focus-request(int);
    callback close(int);
    callback maximize(int);
    callback split(int);
    callback terminal-key(int, string, bool, bool, bool);
    callback terminal-paste(int);
    callback terminal-mouse(int, int, int, int, int, bool, bool, bool);

    background: #070b10;
    border-width: 1px;
    border-color: data.focused ? #2c8fb5 : #17212b;
    clip: true;
    animate border-color { duration: 120ms; }

    Rectangle {
        width: parent.width;
        height: 34px;
        background: data.focused ? #0f1922 : #0a1016;

        TouchArea {
            width: parent.width - 112px;
            height: parent.height;
            clicked => { root.focus-request(root.index); }
        }

        HorizontalBox {
            x: 12px;
            height: parent.height;
            spacing: 8px;
            Text {
                text: data.state == "CONNECTED" ? "●" : data.state == "CONNECTING" ? "◌" : data.state == "ERROR" ? "×" : "○";
                color: data.state == "CONNECTED" ? #67dea0 : data.state == "ERROR" ? #ff6279 : #718394;
                vertical-alignment: center;
            }
            Text { text: data.name; color: #e4ebf2; font-size: 12px; vertical-alignment: center; }
            Text { text: data.host == "" ? "LOCAL" : data.user == "" ? data.host : data.user + "@" + data.host; color: #708294; font-size: 10px; vertical-alignment: center; overflow: elide; }
        }

        HorizontalBox {
            x: parent.width - 112px;
            width: 112px;
            height: parent.height;
            spacing: 2px;
            Button { text: "＋"; clicked => { root.split(root.index); } }
            Button { text: "□"; clicked => { root.maximize(root.index); } }
            Button { text: "×"; clicked => { root.close(root.index); } }
        }
    }

    Rectangle {
        x: 0px;
        y: 34px;
        width: parent.width;
        height: parent.height - 34px;
        background: #03060a;
        clip: true;

        Rectangle {
            x: 10px;
            y: 10px;
            width: parent.width - 20px;
            height: parent.height - 20px;
            clip: true;

            StyledText { width: parent.width; height: parent.height; text: root.data.content; }

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.focus-request(root.index); }
                pointer-event(event) => {
                    let button = event.button == PointerEventButton.left ? 1 : event.button == PointerEventButton.middle ? 2 : event.button == PointerEventButton.right ? 3 : 0;
                    let kind = event.kind == PointerEventKind.down ? 1 : event.kind == PointerEventKind.up ? 2 : event.kind == PointerEventKind.move ? 3 : 0;
                    root.terminal-mouse(root.index, button, kind, self.mouse-x / 1px + 1, self.mouse-y / 1px + 1, event.modifiers.shift, event.modifiers.alt, event.modifiers.control);
                }
                scroll-event(event) => {
                    root.terminal-mouse(root.index, event.delta-y < 0 ? 5 : 4, 1, 1, 1, event.modifiers.shift, event.modifiers.alt, event.modifiers.control);
                    accept
                }
            }

            Rectangle {
                visible: root.data.cursor-visible;
                x: root.data.cursor-x * 8.45px;
                y: root.data.cursor-y * 17px;
                width: 2px;
                height: 16px;
                background: #64ffda;
                opacity: root.data.focused ? 0.95 : 0.50;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "NAGX Connect";
    preferred-width: 1500px;
    preferred-height: 940px;
    min-width: 1060px;
    min-height: 680px;
    background: #05080c;
    default-font-family: "Segoe UI";
    default-font-size: 13px;

    in-out property <string> status-text: "READY";
    in-out property <string> server-text: "No server connected";
    in-out property <string> active-workspace-name: "Overview";
    in-out property <int> active-terminal-index: 0;
    in-out property <bool> command-open: false;
    in-out property <bool> connection-open: true;
    in-out property <int> auth-mode: 0;
    in-out property <string> key-path: "";
    in-out property <string> key-passphrase: "";
    in property <[TerminalData]> terminals: [];

    callback connect-request(int, string, string, int, string, string);
    callback browse-key();
    callback new-terminal();
    callback focus-terminal(int);
    callback close-terminal(int);
    callback maximize-terminal(int);
    callback split-terminal(int);
    callback terminal-key(int, string, bool, bool, bool);
    callback terminal-paste(int);
    callback terminal-resize(int, int, int, int, int);
    callback terminal-mouse(int, int, int, int, int, bool, bool, bool);
    callback focus-input();

    terminal_input := TextEdit {
        x: 0px;
        y: 0px;
        width: 1px;
        height: 1px;
        opacity: 0%;
        enabled: true;
        read-only: true;
        wrap: no-wrap;
        key-pressed(event) => {
            if root.command-open {
                return reject;
            }
            if event.text == "/" && !event.modifiers.control && !event.modifiers.alt {
                root.command-open = true;
                return accept;
            }
            if event.modifiers.control && event.modifiers.shift && (event.text == "v" || event.text == "V") {
                root.terminal-paste(root.active-terminal-index);
                return accept;
            }
            root.terminal-key(root.active-terminal-index, event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
            return accept;
        }
    }
    forward-focus: terminal_input;
    focus-input() => { terminal_input.focus(); }

    function workspace-title(index: int) -> string { return index == 0 ? "Overview" : index == 1 ? "Development" : index == 2 ? "Monitoring" : "Operations"; }
    function terminal-columns(count: int) -> int { return count <= 1 ? 1 : count == 2 ? 2 : count <= 4 ? 2 : count <= 9 ? 3 : 4; }
    function terminal-rows(count: int) -> int { let columns = root.terminal-columns(count); return max(1, (count + columns - 1) / columns); }

    VerticalBox {
        spacing: 0px;
        Rectangle {
            height: 58px;
            background: #080d13;
            border-width: 1px;
            border-color: #121b24;
            HorizontalBox {
                padding-left: 18px;
                padding-right: 14px;
                spacing: 12px;
                alignment: center;
                Text { text: "NAGX"; color: #e1eaf1; font-size: 19px; font-weight: 700; }
                Text { text: "CONNECT"; color: #506577; font-size: 9px; font-weight: 700; }
                Rectangle { width: 1px; height: 22px; background: #17222d; }
                Text { text: root.server-text; color: #93a3b3; font-size: 11px; overflow: elide; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.status-text; color: root.status-text == "READY" ? #6edca3 : #76afd0; font-size: 10px; }
                Button { text: "⌕"; clicked => { root.command-open = true; root.focus-input(); } }
                Button { text: "+"; clicked => { root.new-terminal(); root.focus-input(); } }
                Button { text: "···"; clicked => { root.connection-open = !root.connection-open; root.focus-input(); } }
            }
        }

        HorizontalBox {
            spacing: 0px;
            vertical-stretch: 1;
            Rectangle {
                width: 62px;
                background: #070b10;
                border-width: 1px;
                border-color: #101923;
                VerticalBox {
                    padding-top: 16px;
                    padding-bottom: 16px;
                    spacing: 10px;
                    alignment: center;
                    for item[i] in ["⌂", "⌘", "◈", "⚙"] : Rectangle {
                        width: 38px;
                        height: 38px;
                        background: root.active-workspace-name == root.workspace-title(i) ? #101d27 : #080d13;
                        border-width: 1px;
                        border-color: root.active-workspace-name == root.workspace-title(i) ? #21465d : #101923;
                        TouchArea { clicked => { root.active-workspace-name = root.workspace-title(i); root.focus-input(); } }
                        Text { text: item; color: root.active-workspace-name == root.workspace-title(i) ? #70c7ed : #667687; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Text { text: "N"; color: #344658; font-size: 10px; }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: #05080c;
                clip: true;

                if root.terminals.length == 0 : Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: #05080c;
                    VerticalBox {
                        alignment: center;
                        spacing: 10px;
                        Text { text: "NAGX"; color: #d6e1e9; font-size: 28px; font-weight: 700; horizontal-alignment: center; }
                        Text { text: "Command environment"; color: #607285; font-size: 12px; horizontal-alignment: center; }
                        Button { text: "Create terminal"; clicked => { root.new-terminal(); root.focus-input(); } }
                    }
                }

                for terminal[index] in root.terminals : TerminalWindow {
                    index: index;
                    data: terminal;
                    x: mod(index, root.terminal-columns(root.terminals.length)) * (parent.width / root.terminal-columns(root.terminals.length));
                    y: floor(index / root.terminal-columns(root.terminals.length)) * (parent.height / root.terminal-rows(root.terminals.length));
                    width: parent.width / root.terminal-columns(root.terminals.length);
                    height: parent.height / root.terminal-rows(root.terminals.length);
                    focus-request(index) => { root.focus-terminal(index); root.focus-input(); }
                    close(index) => { root.close-terminal(index); }
                    maximize(index) => { root.maximize-terminal(index); }
                    split(index) => { root.split-terminal(index); root.focus-input(); }
                    terminal-key(index, text, control, alt, shift) => { root.terminal-key(index, text, control, alt, shift); }
                    terminal-paste(index) => { root.terminal-paste(index); }
                    terminal-mouse(index, button, kind, x, y, shift, alt, control) => { root.terminal-mouse(index, button, kind, x, y, shift, alt, control); }
                }

                if root.connection-open : Rectangle {
                    x: 18px;
                    y: 18px;
                    width: min(368px, parent.width - 36px);
                    height: root.auth-mode == 0 ? 270px : 312px;
                    background: #0a1017;
                    border-width: 1px;
                    border-color: #1b2c3a;
                    z: 80;
                    animate height { duration: 160ms; }
                    VerticalBox {
                        padding: 18px;
                        spacing: 8px;
                        Text { text: "CONNECTION"; color: #d7e1e9; font-size: 12px; font-weight: 700; }
                        Text { text: "Active terminal " + (root.active-terminal-index + 1); color: #617285; font-size: 10px; }
                        host-input := LineEdit { placeholder-text: "host or IP"; }
                        user-input := LineEdit { placeholder-text: "username (optional with key)"; }
                        password-input := LineEdit { placeholder-text: "SSH password"; input-type: password; visible: root.auth-mode == 0; }
                        if root.auth-mode == 1 : Rectangle {
                            height: 82px;
                            VerticalBox {
                                spacing: 5px;
                                HorizontalBox {
                                    spacing: 5px;
                                    LineEdit { text: root.key-path; read-only: true; placeholder-text: "private key"; horizontal-stretch: 1; }
                                    Button { text: "BROWSE"; clicked => { root.browse-key(); } }
                                }
                                LineEdit { text: root.key-passphrase; placeholder-text: "key passphrase (optional)"; input-type: password; edited(value) => { root.key-passphrase = value; } }
                            }
                        }
                        HorizontalBox {
                            spacing: 4px;
                            Button { text: "PASSWORD"; clicked => { root.auth-mode = 0; } }
                            Button { text: "PEM / PPK"; clicked => { root.auth-mode = 1; } }
                        }
                        Button {
                            text: root.auth-mode == 0 ? "CONNECT TERMINAL" : "CONNECT WITH KEY";
                            clicked => { root.connect-request(root.active-terminal-index, host-input.text, user-input.text, root.auth-mode, root.auth-mode == 0 ? password-input.text : root.key-path, root.auth-mode == 0 ? "" : root.key-passphrase); }
                        }
                        Text { text: "Additional terminals are independent PTY sessions and can be added with +."; color: #4f6171; font-size: 9px; wrap: word-wrap; }
                    }
                }

                if root.command-open : Rectangle {
                    x: max(20px, parent.width / 2 - 320px);
                    y: 72px;
                    width: min(640px, parent.width - 40px);
                    height: 300px;
                    background: #0a1118;
                    border-width: 1px;
                    border-color: #25465a;
                    z: 100;
                    VerticalBox {
                        padding: 14px;
                        spacing: 8px;
                        Text { text: "/  COMMAND"; color: #d8e2ea; font-size: 11px; font-weight: 700; }
                        LineEdit { placeholder-text: "Search actions, applications, terminals…"; }
                        Text { text: "ACTIONS"; color: #597083; font-size: 9px; }
                        Button { text: "+  New terminal"; clicked => { root.new-terminal(); root.command-open = false; root.focus-input(); } }
                        Button { text: "⌂  Overview"; clicked => { root.active-workspace-name = "Overview"; root.command-open = false; root.focus-input(); } }
                        Button { text: "⌘  Development"; clicked => { root.active-workspace-name = "Development"; root.command-open = false; root.focus-input(); } }
                        Button { text: "◈  Monitoring"; clicked => { root.active-workspace-name = "Monitoring"; root.command-open = false; root.focus-input(); } }
                        Button { text: "⚙  Operations"; clicked => { root.active-workspace-name = "Operations"; root.command-open = false; root.focus-input(); } }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
        }

        Rectangle {
            height: 34px;
            background: #070b10;
            border-width: 1px;
            border-color: #101923;
            HorizontalBox {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 16px;
                alignment: center;
                Text { text: root.active-workspace-name; color: #8ea1b2; font-size: 10px; }
                Text { text: "TERMINALS " + root.terminals.length; color: #4f6476; font-size: 9px; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.status-text; color: #5f8093; font-size: 9px; }
            }
        }
    }
}
