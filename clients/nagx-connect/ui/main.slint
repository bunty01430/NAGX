import { VerticalBox, HorizontalBox, Button, LineEdit, TextEdit } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "NAGX Connect";
    width: 1440px;
    height: 900px;
    background: #06090d;
    default-font-family: "Cascadia Mono";
    default-font-size: 13px;

    in-out property <string> status-text: "DISCONNECTED";
    in-out property <string> server-text: "No server connected";
    in-out property <int> active-workspace: 0;
    in-out property <int> active-terminal: 1;
    in-out property <int> auth-mode: 0;
    in-out property <string> key-path: "";
    in-out property <string> key-passphrase: "";

    in-out property <string> terminal-1-state: "OFFLINE";
    in-out property <string> terminal-2-state: "OFFLINE";
    in-out property <string> terminal-3-state: "OFFLINE";
    in-out property <string> terminal-1-plain: "NAGX terminal 1 offline.";
    in-out property <string> terminal-2-plain: "NAGX terminal 2 offline.";
    in-out property <string> terminal-3-plain: "NAGX terminal 3 offline.";
    in-out property <styled-text> terminal-1-styled: @markdown("NAGX terminal 1 offline.");
    in-out property <styled-text> terminal-2-styled: @markdown("NAGX terminal 2 offline.");
    in-out property <styled-text> terminal-3-styled: @markdown("NAGX terminal 3 offline.");
    in-out property <int> terminal-1-cursor-x: 0;
    in-out property <int> terminal-1-cursor-y: 0;
    in-out property <bool> terminal-1-cursor-visible: false;
    in-out property <bool> terminal-1-mouse-reporting: false;
    in-out property <int> terminal-2-cursor-x: 0;
    in-out property <int> terminal-2-cursor-y: 0;
    in-out property <bool> terminal-2-cursor-visible: false;
    in-out property <bool> terminal-2-mouse-reporting: false;
    in-out property <int> terminal-3-cursor-x: 0;
    in-out property <int> terminal-3-cursor-y: 0;
    in-out property <bool> terminal-3-cursor-visible: false;
    in-out property <bool> terminal-3-mouse-reporting: false;

    in-out property <int> terminal-x: 292;
    in-out property <int> terminal-y: 220;
    in-out property <int> terminal-width: 860;
    in-out property <int> terminal-height: 520;
    in-out property <bool> terminal-minimized: false;
    in-out property <bool> terminal-maximized: false;
    in-out property <bool> terminal-focused: true;

    in-out property <int> logs-x: 560;
    in-out property <int> logs-y: 170;
    in-out property <int> logs-width: 620;
    in-out property <int> logs-height: 360;
    in-out property <bool> logs-open: false;
    in-out property <bool> logs-focused: false;
    private property <bool> focus-terminal-request: false;
    property <int> drag-start-x: 0;
    property <int> drag-start-y: 0;
    property <int> drag-origin-x: 0;
    property <int> drag-origin-y: 0;
    property <int> resize-origin-width: 0;
    property <int> resize-origin-height: 0;
    property <bool> dragging-terminal: false;
    property <bool> dragging-logs: false;
    property <bool> resizing-terminal: false;
    property <bool> resizing-logs: false;

    callback connect-slot(int, string, string, string);
    callback browse-key();
    callback select-terminal(int);
    callback terminal-key(int, string, bool, bool, bool);
    callback terminal-resize(int, int, int, int, int);
    callback terminal-mouse(int, int, int, int, int, bool, bool, bool);
    callback terminal-wheel(int, int);
    callback terminal-paste(int);

    public function focus-terminal() { root.focus-terminal-request = !root.focus-terminal-request; }
    public function focus-terminal-window() { root.terminal-focused = true; root.logs-focused = false; root.terminal-minimized = false; root.select-terminal(root.active-terminal); root.focus-terminal(); }
    public function focus-logs-window() { root.logs-focused = true; root.terminal-focused = false; }
    public function select-terminal-ui(slot: int) { root.active-terminal = root.clamp-slot(slot); root.terminal-minimized = false; root.terminal-focused = true; root.logs-focused = false; root.select-terminal(root.active-terminal); root.focus-terminal(); }
    public pure function clamp-slot(slot: int) -> int { return min(max(slot, 1), 3); }

    VerticalBox {
        spacing: 0px;
        Rectangle { height: 48px; background: #0d1219;
            HorizontalBox { padding-left: 16px; padding-right: 14px; alignment: center; spacing: 14px;
                Text { text: "NAGX"; color: #64ffda; font-size: 22px; font-weight: 700; }
                Text { text: "CONNECT"; color: #718096; font-size: 11px; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.server-text; color: #8c98a6; font-size: 11px; }
                Text { text: "|"; color: #263342; }
                Text { text: root.status-text; color: #64ffda; font-size: 11px; }
            }
        }
        Rectangle { height: 38px; background: #0a0f15;
            HorizontalBox { padding-left: 12px; spacing: 6px;
                Button { text: "Overview"; clicked => { root.active-workspace = 0; } }
                Button { text: "Development"; clicked => { root.active-workspace = 1; } }
                Button { text: "Monitoring"; clicked => { root.active-workspace = 2; } }
                Button { text: "Operations"; clicked => { root.active-workspace = 3; } }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "Alt+1..4 workspaces | Alt+Tab terminals"; color: #5b6978; font-size: 10px; vertical-alignment: center; }
            }
        }
        Rectangle { vertical-stretch: 1; background: #06090d;
            Rectangle { x: 12px; y: 12px; width: 250px; height: parent.height - 24px; background: #090d13;
                VerticalBox { padding: 14px; spacing: 8px;
                    Text { text: "CONNECTION"; color: #718096; font-size: 10px; }
                    host-input := LineEdit { placeholder-text: "host or IP"; }
                    user-input := LineEdit { placeholder-text: "username"; }
                    password-input := LineEdit { placeholder-text: "SSH password"; input-type: password; visible: root.auth-mode == 0; }
                    HorizontalBox { spacing: 4px;
                        Button { text: "PASSWORD"; clicked => { root.auth-mode = 0; } }
                        Button { text: "PEM / PPK"; clicked => { root.auth-mode = 1; } }
                    }
                    if root.auth-mode == 1 : Rectangle { height: 74px;
                        VerticalBox { spacing: 5px;
                            HorizontalBox { spacing: 4px;
                                LineEdit { text: root.key-path; placeholder-text: "private key"; read-only: true; horizontal-stretch: 1; }
                                Button { text: "BROWSE"; clicked => { root.browse-key(); } }
                            }
                            LineEdit { text: root.key-passphrase; placeholder-text: "key passphrase"; input-type: password; edited(text) => { root.key-passphrase = text; } }
                        }
                    }
                    Button { text: "CONNECT T" + root.active-terminal; clicked => { root.connect-slot(root.active-terminal, host-input.text, user-input.text, root.auth-mode == 0 ? password-input.text : "NAGXKEY:" + root.key-path + "\n" + root.key-passphrase); } }
                    Text { text: "SSH password or private key"; color: #4f5d6b; font-size: 10px; }
                    Rectangle { vertical-stretch: 1; }
                    Text { text: "TERMINALS"; color: #718096; font-size: 10px; }
                    Button { text: "T1  " + root.terminal-1-state; clicked => { root.select-terminal-ui(1); } }
                    Button { text: "T2  " + root.terminal-2-state; clicked => { root.select-terminal-ui(2); } }
                    Button { text: "T3  " + root.terminal-3-state; clicked => { root.select-terminal-ui(3); } }
                    Rectangle { height: 1px; background: #17202a; }
                    Button { text: "Logs"; clicked => { root.logs-open = true; root.focus-logs-window(); } }
                    Text { text: root.active-workspace == 0 ? "WORKSPACE 1 · OVERVIEW" : root.active-workspace == 1 ? "WORKSPACE 2 · DEVELOPMENT" : root.active-workspace == 2 ? "WORKSPACE 3 · MONITORING" : "WORKSPACE 4 · OPERATIONS"; color: #64ffda; font-size: 10px; }
                }
            }

            Rectangle { x: 284px; y: 12px; width: parent.width - 296px; height: 126px; background: #0a1118; border-width: 1px; border-color: #172431;
                Text { x: 14px; y: 12px; text: root.active-workspace == 0 ? "SYSTEM OVERVIEW" : root.active-workspace == 1 ? "DEVELOPMENT" : root.active-workspace == 2 ? "MONITORING" : "OPERATIONS"; color: #d7dee8; font-size: 14px; font-weight: 700; }
                Text { x: 14px; y: 48px; text: root.active-workspace == 0 ? "CPU   -- %     RAM   -- %     DISK   -- %     GPU   -- %" : root.active-workspace == 1 ? "Terminal · Editor · Files · Git" : root.active-workspace == 2 ? "CPU · RAM · GPU · Network · Processes · Logs" : "Services · Docker · Firewall · Events"; color: #9aa7b6; font-size: 12px; }
            }

            if !root.terminal-minimized : Rectangle {
                x: root.terminal-maximized ? 284px : root.terminal-x * 1px;
                y: root.terminal-maximized ? 150px : root.terminal-y * 1px;
                width: root.terminal-maximized ? parent.width - 296px : root.terminal-width * 1px;
                height: root.terminal-maximized ? parent.height - 188px : root.terminal-height * 1px;
                z: 20; background: #020407; border-width: 1px; border-color: root.terminal-focused ? #31546a : #18212c;
                TouchArea { x: 0px; y: 0px; width: parent.width - 90px; height: 28px; mouse-cursor: move;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down { root.focus-terminal-window(); root.dragging-terminal = true; root.drag-start-x = self.mouse-x / 1px; root.drag-start-y = self.mouse-y / 1px; root.drag-origin-x = root.terminal-x; root.drag-origin-y = root.terminal-y; }
                        else if event.kind == PointerEventKind.move && root.dragging-terminal && !root.terminal-maximized { root.terminal-x = min(max(root.drag-origin-x + self.mouse-x / 1px - root.drag-start-x, 284), max(284, 1400 - root.terminal-width)); root.terminal-y = min(max(root.drag-origin-y + self.mouse-y / 1px - root.drag-start-y, 0), max(0, 760 - root.terminal-height)); }
                        else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { root.dragging-terminal = false; }
                    }
                }
                Rectangle { width: parent.width; height: 28px; background: root.terminal-focused ? #0f1820 : #0b1118;
                    Text { x: 10px; text: "NAGX TERMINAL " + root.active-terminal; color: #d7dee8; font-size: 12px; vertical-alignment: center; }
                    HorizontalBox { x: parent.width - 84px; width: 84px; height: 28px;
                        Button { text: "—"; clicked => { root.terminal-minimized = true; } }
                        Button { text: root.terminal-maximized ? "❐" : "□"; clicked => { root.terminal-maximized = !root.terminal-maximized; } }
                        Button { text: "×"; clicked => { root.terminal-minimized = true; } }
                    }
                }
                Rectangle { x: 0px; y: 28px; width: parent.width; height: parent.height - 28px; background: #020407; clip: true;
                    Rectangle { x: 10px; y: 8px; width: parent.width - 20px; height: parent.height - 16px; clip: true;
                        StyledText { width: parent.width; height: parent.height; text: root.active-terminal == 1 ? root.terminal-1-styled : root.active-terminal == 2 ? root.terminal-2-styled : root.terminal-3-styled; }
                        terminal-input := TextEdit { width: parent.width; height: parent.height; text: root.active-terminal == 1 ? root.terminal-1-plain : root.active-terminal == 2 ? root.terminal-2-plain : root.terminal-3-plain; read-only: true; wrap: no-wrap; opacity: 0%; changed root.focus-terminal-request => { self.focus(); } key-pressed(event) => {
                            if event.modifiers.alt {
                                if event.text == "1" { root.select-terminal-ui(1); accept; }
                                if event.text == "2" { root.select-terminal-ui(2); accept; }
                                if event.text == "3" { root.select-terminal-ui(3); accept; }
                                if event.text == "Tab" { root.select-terminal-ui(root.active-terminal == 3 ? 1 : root.active-terminal + 1); accept; }
                            }
                            if event.modifiers.control && event.modifiers.shift {
                                if event.text == "v" || event.text == "V" { root.terminal-paste(root.active-terminal); accept; }
                                if event.text == "a" || event.text == "A" { terminal-input.select-all(); accept; }
                                if event.text == "c" || event.text == "C" { terminal-input.copy(); accept; }
                            }
                            root.terminal-key(root.active-terminal, event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift); accept;
                        } }
                        TouchArea { visible: root.active-terminal == 1 ? root.terminal-1-mouse-reporting : root.active-terminal == 2 ? root.terminal-2-mouse-reporting : root.terminal-3-mouse-reporting; enabled: self.visible;
                            pointer-event(event) => { let button = event.button == PointerEventButton.left ? 1 : event.button == PointerEventButton.middle ? 2 : event.button == PointerEventButton.right ? 3 : 0; let kind = event.kind == PointerEventKind.down ? 1 : event.kind == PointerEventKind.up ? 2 : event.kind == PointerEventKind.move ? 3 : 0; root.terminal-mouse(root.active-terminal, button, kind, self.mouse-x / 1px + 1, self.mouse-y / 1px + 1, event.modifiers.shift, event.modifiers.alt, event.modifiers.control); }
                            scroll-event(event) => { root.terminal-wheel(root.active-terminal, event.delta-y / 1px); accept }
                        }
                        Rectangle { visible: root.active-terminal == 1 ? root.terminal-1-cursor-visible : root.active-terminal == 2 ? root.terminal-2-cursor-visible : root.terminal-3-cursor-visible; x: (root.active-terminal == 1 ? root.terminal-1-cursor-x : root.active-terminal == 2 ? root.terminal-2-cursor-x : root.terminal-3-cursor-x) * 8.45px; y: (root.active-terminal == 1 ? root.terminal-1-cursor-y : root.active-terminal == 2 ? root.terminal-2-cursor-y : root.terminal-3-cursor-y) * 17px; width: 2px; height: 16px; background: #64ffda; }
                    }
                }
                TouchArea { x: parent.width - 18px; y: parent.height - 18px; width: 18px; height: 18px; mouse-cursor: se-resize;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down { root.resizing-terminal = true; root.resize-origin-width = root.terminal-width; root.resize-origin-height = root.terminal-height; root.drag-start-x = self.mouse-x / 1px; root.drag-start-y = self.mouse-y / 1px; root.focus-terminal-window(); }
                        else if event.kind == PointerEventKind.move && root.resizing-terminal && !root.terminal-maximized { root.terminal-width = min(max(root.resize-origin-width + self.mouse-x / 1px - root.drag-start-x, 480), 1400); root.terminal-height = min(max(root.resize-origin-height + self.mouse-y / 1px - root.drag-start-y, 240), 760); }
                        else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { root.resizing-terminal = false; }
                    }
                }
            }

            if root.terminal-minimized : Rectangle { x: root.terminal-x * 1px; y: root.terminal-y * 1px; width: 310px; height: 28px; z: 20; background: #0b1118; border-width: 1px; border-color: #18212c;
                HorizontalBox { Text { text: "NAGX T" + root.active-terminal + " minimized"; color: #718096; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } Button { text: "Restore"; clicked => { root.focus-terminal-window(); } } }
            }

            if root.logs-open : Rectangle { x: root.logs-x * 1px; y: root.logs-y * 1px; width: root.logs-width * 1px; height: root.logs-height * 1px; z: 10; background: #05080c; border-width: 1px; border-color: root.logs-focused ? #31546a : #18212c;
                TouchArea { x: 0px; y: 0px; width: parent.width - 36px; height: 28px; mouse-cursor: move;
                    pointer-event(event) => { if event.kind == PointerEventKind.down { root.focus-logs-window(); root.dragging-logs = true; root.drag-start-x = self.mouse-x / 1px; root.drag-start-y = self.mouse-y / 1px; root.drag-origin-x = root.logs-x; root.drag-origin-y = root.logs-y; } else if event.kind == PointerEventKind.move && root.dragging-logs { root.logs-x = min(max(root.drag-origin-x + self.mouse-x / 1px - root.drag-start-x, 284), max(284, 1400 - root.logs-width)); root.logs-y = min(max(root.drag-origin-y + self.mouse-y / 1px - root.drag-start-y, 0), max(0, 760 - root.logs-height)); } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { root.dragging-logs = false; } }
                }
                Rectangle { width: parent.width; height: 28px; background: root.logs-focused ? #0f1820 : #0b1118; Text { x: 10px; text: "NAGX LOGS"; color: #d7dee8; font-size: 12px; vertical-alignment: center; } Button { x: parent.width - 36px; width: 36px; height: 28px; text: "×"; clicked => { root.logs-open = false; root.logs-focused = false; root.terminal-focused = true; } } }
                Text { x: 14px; y: 42px; text: "[system]\n[ssh] terminal session events\n[pty] three-slot transport\n[services] telemetry pending"; color: #9aa7b6; font-size: 12px; }
                TouchArea { x: parent.width - 18px; y: parent.height - 18px; width: 18px; height: 18px; mouse-cursor: se-resize;
                    pointer-event(event) => { if event.kind == PointerEventKind.down { root.resizing-logs = true; root.resize-origin-width = root.logs-width; root.resize-origin-height = root.logs-height; root.drag-start-x = self.mouse-x / 1px; root.drag-start-y = self.mouse-y / 1px; root.focus-logs-window(); } else if event.kind == PointerEventKind.move && root.resizing-logs { root.logs-width = min(max(root.resize-origin-width + self.mouse-x / 1px - root.drag-start-x, 360), 1200); root.logs-height = min(max(root.resize-origin-height + self.mouse-y / 1px - root.drag-start-y, 220), 700); } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { root.resizing-logs = false; } }
                }
            }
        }
        Rectangle { height: 38px; background: #0a0f15;
            HorizontalBox { padding-left: 10px; spacing: 8px;
                Button { text: "T1"; clicked => { root.select-terminal-ui(1); } }
                Button { text: "T2"; clicked => { root.select-terminal-ui(2); } }
                Button { text: "T3"; clicked => { root.select-terminal-ui(3); } }
                Button { text: "Logs"; clicked => { root.logs-open = true; root.focus-logs-window(); } }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "NAGX / native client / SSH + PEM + PPK"; color: #4f5d6b; font-size: 10px; vertical-alignment: center; }
            }
        }
    }
}
